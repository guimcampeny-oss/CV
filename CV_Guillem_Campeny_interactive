    <div class="tech">${d.tech.map(t=>`<b>${t.label}</b><span>${t.value}</span>`).join('')}</div>

    <div class="sec">${svg('cap')}${d.sec.education}</div>
    ${d.education.map(e=>`<div class="item"><div class="per">${e.per}</div><div class="txt">${e.txt}</div></div>`).join('')}

    <div class="sec">${svg('award')}${d.sec.certificates}</div>
    ${d.certificates.map(e=>`<div class="item"><div class="per">${e.per}</div><div class="txt">${e.txt}</div></div>`).join('')}
  `;

  const exp = d.experience.map((e,i)=>{
    const has = Array.isArray(e.details) && e.details.length;
    const open = openSet.has(i);
    if(has){
      return `<div class="exp expandable${open?' open':''}" data-i="${i}">
        <button class="exp-head" aria-expanded="${open}" data-toggle="${i}">
          <span class="exp-l">
            <span class="role">${e.role}${svg('chev','chev')}</span>
            <span class="cco"><b>${e.company}</b><i>${e.location}</i></span>
          </span>
          <span class="dates">${e.dates}</span>
        </button>
        <div class="exp-desc"><div><ul>${e.details.map(x=>`<li>${x}</li>`).join('')}</ul></div></div>
      </div>`;
    }
    const co = e.companies
      ? e.companies.map(c=>`<span class="cco"><b>${c.name}</b><i>${c.location}</i><span class="subdate">${c.period}</span></span>`).join('')
      : `<span class="cco"><b>${e.company}</b><i>${e.location}</i></span>`;
    return `<div class="exp" data-i="${i}">
      <div class="exp-head">
        <span class="exp-l">
          <span class="role">${e.role}</span>
          ${co}
        </span>
        <span class="dates">${e.dates}</span>
      </div>
      ${e.note?`<div class="note">${e.note}</div>`:''}
    </div>`;
  }).join('');

  const main = `
    <div class="sec">${svg('user')}${d.sec.profile}</div>
    <p class="profile">${d.profile}</p>
    <div class="sec">${svg('briefcase')}${d.sec.experience}</div>
    ${exp}
  `;

  document.getElementById('cv').innerHTML = `
    <header class="top">
      <div>
        <h1 class="name">${d.name}</h1>
        <div class="headline">${d.headline}</div>
      </div>
      <div class="controls">
        <div class="seg" role="group" aria-label="Language">
          <button data-lang="en" class="${lang==='en'?'active':''}">EN</button>
          <button data-lang="ca" class="${lang==='ca'?'active':''}">CA</button>
        </div>
        <button class="print" id="printBtn">
          <svg viewBox="0 0 24 24" style="stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round"><path d="M6 9V2h12v7"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
          ${lang==='en'?'Save as PDF':'Desar en PDF'}</button>
      </div>
    </header>
    <div class="grid">
      <aside>${aside}</aside>
      <section>${main}</section>
    </div>`;

  document.getElementById('foot').textContent = d.hint;

  // wire language buttons
  document.querySelectorAll('[data-lang]').forEach(b=>{
    b.addEventListener('click',()=>{ lang=b.dataset.lang; render(); });
  });
  // wire expand toggles
  document.querySelectorAll('[data-toggle]').forEach(b=>{
    b.addEventListener('click',()=>{
      const i=+b.dataset.toggle;
      const card=b.closest('.exp');
      if(openSet.has(i)){openSet.delete(i);card.classList.remove('open');b.setAttribute('aria-expanded','false');}
      else{openSet.add(i);card.classList.add('open');b.setAttribute('aria-expanded','true');}
    });
  });
  document.getElementById('printBtn').addEventListener('click',()=>window.print());
}

render();
</script>
</body>
</html>
