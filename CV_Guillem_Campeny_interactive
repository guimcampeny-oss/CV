<style>
  :root{
    --blue:#1E5A8A;
    --blue-soft:#EAF1F6;
    --green:#3D8168;
    --gray:#6B7280;
    --gray-lt:#9AA3AD;
    --ink:#1F2328;
    --sub:#3D4148;
    --rule:#E3E8ED;
    --dot-off:#CBD3DB;
    --page:#F4F6F8;
    --card:#FFFFFF;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    font-family:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;
    background:var(--page);
    color:var(--ink);
    line-height:1.5;
    -webkit-font-smoothing:antialiased;
    padding:32px 16px 64px;
  }
  .card{
    max-width:860px;margin:0 auto;background:var(--card);
    border-radius:14px;
    box-shadow:0 1px 2px rgba(20,40,60,.04),0 12px 40px rgba(20,40,60,.08);
    padding:44px 46px 48px;
  }

  /* header */
  .top{display:flex;justify-content:space-between;align-items:flex-start;gap:20px;
    border-bottom:2px solid var(--blue);padding-bottom:16px;margin-bottom:6px;}
  .name{font-size:30px;font-weight:700;letter-spacing:.06em;color:var(--blue);margin:0 0 4px;line-height:1.1;}
  .headline{font-size:14px;color:var(--gray);letter-spacing:.02em;}
  .headline b{color:var(--sub);font-weight:500;}

  /* controls */
  .controls{display:flex;flex-direction:column;align-items:flex-end;gap:8px;flex-shrink:0;}
  .seg{display:inline-flex;border:1px solid var(--rule);border-radius:999px;overflow:hidden;background:#fff;}
  .seg button{appearance:none;border:0;background:transparent;font:inherit;font-weight:600;
    font-size:12px;letter-spacing:.06em;color:var(--gray);padding:7px 14px;cursor:pointer;transition:.15s;}
  .seg button.active{background:var(--blue);color:#fff;}
  .seg button:not(.active):hover{background:var(--blue-soft);color:var(--blue);}
  .print{appearance:none;border:1px solid var(--rule);background:#fff;border-radius:999px;
    font:inherit;font-size:12px;font-weight:500;color:var(--gray);padding:6px 12px;cursor:pointer;
    display:inline-flex;align-items:center;gap:6px;transition:.15s;}
  .print:hover{border-color:var(--blue);color:var(--blue);}
  .print svg{width:13px;height:13px;}

  /* layout */
  .grid{display:grid;grid-template-columns:1fr 1.92fr;gap:38px;margin-top:26px;}
  @media(max-width:720px){
    .grid{grid-template-columns:1fr;gap:8px;}
    .card{padding:30px 24px 34px;}
    .top{flex-direction:column;}
    .controls{align-items:flex-start;flex-direction:row;}
  }

  /* section titles */
  .sec{display:flex;align-items:center;gap:8px;color:var(--blue);
    font-size:12.5px;font-weight:700;letter-spacing:.11em;text-transform:uppercase;
    padding-bottom:7px;border-bottom:1px solid var(--rule);margin:26px 0 12px;}
  .sec:first-child{margin-top:0;}
  .sec svg{width:15px;height:15px;stroke:var(--blue);fill:none;stroke-width:2;
    stroke-linecap:round;stroke-linejoin:round;flex-shrink:0;}
  aside .sec:first-of-type{margin-top:0;}

  /* contact */
  .crow{display:flex;align-items:flex-start;gap:9px;font-size:13px;color:var(--ink);margin:0 0 7px;}
  .crow svg{width:13px;height:13px;stroke:var(--blue);fill:none;stroke-width:2;
    stroke-linecap:round;stroke-linejoin:round;flex-shrink:0;margin-top:3px;}
  .crow a{color:var(--ink);text-decoration:none;}
  .crow a:hover{color:var(--blue);text-decoration:underline;}

  /* languages */
  .lang{display:flex;align-items:center;justify-content:space-between;gap:10px;margin:0 0 8px;}
  .lang .lx{font-size:13px;}
  .lang .lx b{font-weight:500;color:var(--ink);}
  .lang .lx span{color:var(--gray);font-size:11.5px;margin-left:5px;}
  .dots{display:inline-flex;gap:3px;flex-shrink:0;}
  .dot{width:7px;height:7px;border-radius:50%;background:var(--dot-off);}
  .dot.on{background:var(--green);}

  /* generic sidebar item */
  .item{margin:0 0 12px;}
  .item .per{font-size:11px;font-weight:600;letter-spacing:.05em;color:var(--gray);text-transform:uppercase;}
  .item .txt{font-size:13px;color:var(--ink);margin-top:1px;}
  .tech b{display:block;font-size:13px;color:var(--ink);margin-top:8px;}
  .tech span{font-size:13px;color:var(--gray);}

  /* profile */
  .profile{font-size:14px;color:var(--sub);margin:2px 0 4px;}

  /* experience */
  .exp{border-bottom:1px solid var(--rule);}
  .exp:last-child{border-bottom:0;}
  .exp-head{width:100%;text-align:left;background:transparent;border:0;font:inherit;
    display:flex;justify-content:space-between;align-items:baseline;gap:14px;
    padding:13px 8px 13px 0;cursor:default;border-radius:8px;transition:background .15s;}
  .exp.expandable .exp-head{cursor:pointer;padding-left:10px;margin-left:-10px;}
  .exp.expandable .exp-head:hover{background:var(--blue-soft);}
  .exp-head:focus-visible{outline:2px solid var(--blue);outline-offset:2px;}
  .exp-l{min-width:0;}
  .role{font-size:14.5px;font-weight:600;color:var(--ink);display:flex;align-items:center;gap:8px;flex-wrap:wrap;}
  .chev{width:15px;height:15px;stroke:var(--blue);fill:none;stroke-width:2.2;
    stroke-linecap:round;stroke-linejoin:round;transition:transform .28s ease;flex-shrink:0;}
  .exp.open .chev{transform:rotate(180deg);}
  .cco{display:block;font-size:13px;margin-top:2px;}
  .cco + .cco{margin-top:4px;}
  .cco b{color:var(--blue);font-weight:600;}
  .cco i{color:var(--gray);font-style:italic;margin-left:6px;}
  .subdate{color:var(--gray);font-size:12px;margin-left:8px;white-space:nowrap;}
  .dates{font-size:12px;color:var(--gray);white-space:nowrap;flex-shrink:0;padding-top:1px;}
  .note{font-size:13px;color:var(--sub);padding:0 8px 13px 0;margin-top:-4px;}

  /* collapsible */
  .exp-desc{display:grid;grid-template-rows:0fr;transition:grid-template-rows .3s ease;}
  .exp.open .exp-desc{grid-template-rows:1fr;}
  .exp-desc>div{overflow:hidden;}
  .exp-desc ul{margin:0;padding:2px 4px 16px 6px;list-style:none;}
  .exp-desc li{position:relative;padding-left:18px;font-size:13px;color:var(--sub);margin-bottom:6px;line-height:1.45;}
  .exp-desc li::before{content:"";position:absolute;left:2px;top:8px;width:5px;height:5px;
    border-radius:50%;background:var(--green);}

  .foot{max-width:860px;margin:16px auto 0;text-align:center;font-size:11px;color:var(--gray-lt);}

  @media print{
    body{background:#fff;padding:0;}
    .card{box-shadow:none;border-radius:0;max-width:none;padding:0;}
    .controls,.foot{display:none;}
    .exp.expandable .exp-head{cursor:default;padding-left:0;margin-left:0;}
    .exp-desc{grid-template-rows:1fr;}
    .chev{display:none;}
    .exp-head:hover{background:transparent;}
    *{-webkit-print-color-adjust:exact;print-color-adjust:exact;}
  }
</style>
